<?xml version="1.0" encoding="utf-8"?>
<!--
  ictMail MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build mailcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome, license, a feature tree, progress, and a finish page. The
  dialog set is WiX's WixUI_FeatureTree replicated below (the UI extension's own ExitDialog
  cannot be changed, and the finish page needs its own checkbox), with ictMail's banner and
  side bitmaps (WixUIBannerBmp/WixUIDialogBmp, made by packaging/windows/make-bmps.py) and a
  finish page that offers to launch ictMail (ticked by default). A shortcut to ictMail is
  also put on the installing user's desktop by a custom action after the install finishes —
  the finish page runs once the files are already in place, so it cannot be an installed
  component. Silent installs (/qn) never show the page and make no desktop shortcut.
  package.ps1 builds the license RTF from LICENSE-MIT and LICENSE-APACHE.

  Two features: "ictMail" (the program itself) and "ictMail ActiveSync", which the app
  reads through HKLM\Software\ictMail\DavSync = 1. Unticking it on the feature page (or
  later through Programs and Features > Change) installs the base IMAP-only app; ticking it
  again adds the flag back. ARPNOMODIFY stays off so that Change entry point exists.

  UpgradeCode and the component GUIDs below belong to ictMail alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="ictMail"
      Manufacturer="ictTech"
      Version="$(var.Version)"
      UpgradeCode="647FB3CC-7876-4DC8-84D9-CE2DD295D1C7"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="ictMail mail and calendar" Manufacturer="ictTech" />
    <!-- Any other version replaces the one installed: a newer one, the same X.Y.Z (successive
         pre-releases of one X.Y.Z replace each other; MSI versions are numeric, so 1.2.3-rc.1 and
         1.2.3-rc.2 are both 1.2.3; AllowDowngrades takes in AllowSameVersionUpgrades) and an
         older one. Downgrades are allowed so that ictMail can go back to the version an update replaced, when the
         new one doesn't start (apps/mailcraft/src/self_update.rs): installing this package over
         a newer ictMail replaces it. The mailbox is in the user's own folder either way. -->
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="IctMailIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="IctMailIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://ictmail.ca" />
    <Property Id="ARPURLUPDATEINFO" Value="https://ictmail.ca" />
    <Property Id="ARPHELPLINK" Value="https://ictmail.ca" />

    <!-- Installer UI: the WixUI_FeatureTree dialog set, copied from the UI extension's own
         WixUI_FeatureTree.wxs (TextStyles, DialogRefs and Publishes are its, verbatim where
         they can be) with three changes: the feature page is ours (IctMailCustomizeDlg
         below) so it has no Browse button — no feature offers its own directory, and the
         stock button would open a picker that changes nothing; the finish page is ours
         (IctMailExitDialog) so it can carry the launch checkbox; and the
         license page's Print button needs no per-architecture action (LicenseAgreementDlg
         prints through the MsiPrint event itself, unlike Minimal's WelcomeEulaDlg).
         ARPNOMODIFY is deliberately absent: Programs and Features must keep its Change
         entry, which is how the calendar/contacts feature is turned on or off after
         install. The launch-on-finish action is WixShellExec (WixToolset.Util.wixext); the
         desktop shortcut is WixQuietExec running PowerShell's WScript.Shell, since the .lnk
         must be made after the install and Windows Installer has no post-install shortcut
         table. Both are immediate, impersonated custom actions: they run as the person who
         clicked Finish. The shortcut goes to that user's own Desktop (the shell's
         SpecialFolders "Desktop", which honours a redirected e.g. OneDrive desktop and
         localized folder names), never [DesktopFolder]: for a per-machine package that
         property is the all-users Public Desktop, which only an elevated process can
         write, so a normal (medium-integrity) install silently failed to make the
         shortcut there. The user's own Desktop is writable at any integrity level. The
         same command removes the shortcut on uninstall: it looks for ictmail.exe, which
         exists once the install has finished and is gone once the uninstall has, so one
         static command creates on install and deletes on uninstall.
         RemoveDesktopShortcut runs it from the execute sequence on REMOVE="ALL".
         Return="ignore": a shortcut that can't be made never fails the install. The finish
         page only shows for a fresh install or upgrade (NOT Installed keeps it — and both
         actions — off repairs, changes and uninstalls). -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ictMail" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#MailcraftExe]" />
    <!-- The whole command line of the shortcut maker/remover, run by both
         CreateDesktopShortcut (finish page) and RemoveDesktopShortcut (uninstall).
         It must begin with a quoted program name (WixQuietExec's rule); [SystemFolder]
         is the Windows folder of the package's own bitness, where PowerShell always
         lives. The script is base64 (-EncodedCommand) because a -Command string this
         long does not survive WixQuietExec's command-line parsing. It needs no MSI
         properties: the shell's SpecialFolders gives the installing user's own Desktop
         (a redirected e.g. OneDrive desktop and localized names included — never
         [DesktopFolder], which for a per-machine package is the all-users Public
         Desktop only an elevated process can write), and the presence of ictmail.exe
         tells install-finish (create) from uninstall-finish (delete). -->
    <Property Id="WixQuietExecCmdLine" Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand " />
    <CustomAction Id="LaunchMailcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <CustomAction Id="CreateDesktopShortcut" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
        Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemoveDesktopShortcut" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <!-- Everything below that is not ours is WixUI_FeatureTree's, kept so the dialogs,
           their wiring (feature, maintenance, patch and error flows) and the common texts
           and bitmaps behave exactly as the stock set does. -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- The feature page: the extension's CustomizeDlg minus its Browse button (see the
           comment above the UI). Everything else is its, verbatim: the SelectionTree bound
           to _BrowseProperty is what makes the Feature table's checkboxes work, and the
           Reset/Disk Usage/Back/Next/Cancel wiring is unchanged. Its own Id
           (IctMailCustomizeDlg) for the same reason as IctMailExitDialog: WiX links a
           library fragment for every symbol a package references, and a second
           "CustomizeDlg" would be a duplicate. The flow dialogs it moves between
           (WelcomeDlg, LicenseAgreementDlg, VerifyReadyDlg, the maintenance dialogs) are
           pulled in by the Publish references below, as they are in the stock set. -->
      <Dialog Id="IctMailCustomizeDlg" Width="370" Height="270" Title="!(loc.CustomizeDlg_Title)" TrackDiskSpace="yes">
        <Control Id="Tree" Type="SelectionTree" X="25" Y="85" Width="175" Height="115" Property="_BrowseProperty" Sunken="yes" TabSkip="no" Text="!(loc.CustomizeDlgTree)" />
        <Control Id="Reset" Type="PushButton" X="10" Y="243" Width="81" Height="17" Text="!(loc.CustomizeDlgReset)">
          <Publish Event="Reset" Value="0" />
          <Subscribe Event="SelectionNoItems" Attribute="Enabled" />
        </Control>
        <Control Id="DiskCost" Type="PushButton" X="91" Y="243" Width="100" Height="17" Text="!(loc.CustomizeDlgDiskCost)">
          <Publish Event="SpawnDialog" Value="DiskCostDlg" />
          <Subscribe Event="SelectionNoItems" Attribute="Enabled" />
        </Control>
        <Control Id="Back" Type="PushButton" X="192" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="248" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Subscribe Event="SelectionNoItems" Attribute="Enabled" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.CustomizeDlgBannerBitmap)" />
        <Control Id="Text" Type="Text" X="25" Y="55" Width="320" Height="20" Text="!(loc.CustomizeDlgText)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.CustomizeDlgDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="210" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.CustomizeDlgTitle)" />
        <Control Id="Box" Type="GroupBox" X="210" Y="81" Width="150" Height="118" />
        <Control Id="ItemDescription" Type="Text" X="215" Y="90" Width="131" Height="50" Text="!(loc.CustomizeDlgItemDescription)">
          <Subscribe Event="SelectionDescription" Attribute="Text" />
        </Control>
        <Control Id="ItemSize" Type="Text" X="215" Y="140" Width="131" Height="50" Text="!(loc.CustomizeDlgItemSize)">
          <Subscribe Event="SelectionSize" Attribute="Text" />
        </Control>
        <Control Id="Location" Type="Text" X="90" Y="210" Width="200" Height="20" Text="!(loc.CustomizeDlgLocation)" HideCondition="Installed">
          <Subscribe Event="SelectionPath" Attribute="Text" />
          <Subscribe Event="SelectionPathOn" Attribute="Visible" />
        </Control>
        <Control Id="LocationLabel" Type="Text" X="25" Y="210" Width="65" Height="10" Text="!(loc.CustomizeDlgLocationLabel)" HideCondition="Installed">
          <Subscribe Event="SelectionPathOn" Attribute="Visible" />
        </Control>
      </Dialog>

      <!-- The finish page: the extension's ExitDialog minus its desktop-shortcut checkbox —
           the shortcut is always made for the installing user now, so there is nothing to
           choose. It has its own Id (IctMailExitDialog) so the UI extension's ExitDialog
           fragment is never pulled in — WiX links a library fragment for every symbol a
           package references, and a second "ExitDialog" would be a duplicate. The optional
           launch checkbox keeps its WIXUI_EXITDIALOGOPTIONAL* wiring. -->
      <Dialog Id="IctMailExitDialog" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="34" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogDescription)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogTitle)" />
        <Control Id="OptionalText" Type="Text" X="135" Y="106" Width="220" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[WIXUI_EXITDIALOGOPTIONALTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALTEXT AND NOT Installed" />
        <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="132" Width="220" Height="20" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" Text="[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT AND NOT Installed" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="IctMailExitDialog" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="IctMailExitDialog" OnExit="success" />
      </AdminUISequence>
      <Publish Dialog="IctMailExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="IctMailExitDialog" Control="Finish" Event="DoAction" Value="LaunchMailcraft" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="IctMailExitDialog" Control="Finish" Event="DoAction" Value="CreateDesktopShortcut" Order="2" Condition="NOT Installed" />

      <!-- The rest is WixUI_FeatureTree's wiring, with CustomizeDlg renamed to
           IctMailCustomizeDlg. Its ExitDialog publish is ours already (the three
           IctMailExitDialog publishes above), and it has no BrowseDlg publishes — the
           stock ones served the Browse button this dialog set doesn't have. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="IctMailCustomizeDlg" Condition="LicenseAccepted = &quot;1&quot;" />
      <Publish Dialog="IctMailCustomizeDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" Condition="Installed" />
      <Publish Dialog="IctMailCustomizeDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="IctMailCustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="IctMailCustomizeDlg" Order="1" Condition="NOT Installed OR WixUI_InstallMode = &quot;Change&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="IctMailCustomizeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <UIRef Id="WixUI_Common" />
    </UI>

    <!-- The uninstall half of the desktop shortcut: the same WixQuietExecCmdLine command,
         which deletes instead of creates because ictmail.exe is already gone. Runs in the
         execute sequence so silent uninstalls clean up too; after InstallFinalize the product
         is already unregistered but the session still impersonates the user. -->
    <InstallExecuteSequence>
      <Custom Action="RemoveDesktopShortcut" After="InstallFinalize" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- An organisation turns ictMail's updating by itself off for every user of the computer
         by installing with DISABLEAUTOMATICUPDATES=1
         (`msiexec /i ictmail-….msi DISABLEAUTOMATICUPDATES=1`): the policy value the program
         reads (HKLM\Software\Policies\ictMail, DisableAutomaticUpdates = 1) is written, and
         removed again with the program. A Group Policy can set the same value instead. -->
    <Property Id="DISABLEAUTOMATICUPDATES" Secure="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ictMail" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- The program itself. Everything the app needs to run and be found lives here, so
         unchecking it on the feature page installs nothing; the tree's Next stays disabled
         while no feature is selected (SelectionNoItems). -->
    <Feature Id="Main" Title="ictMail" Description="The ictMail mail client." Level="1">
      <ComponentGroupRef Id="MailcraftFiles" />
    </Feature>

    <!-- Calendar and contacts sync, shown to the owner as "ictMail ActiveSync". The DAV code
         is part of ictMail.exe itself, so what this feature installs is the switch that
         turns it on: HKLM\Software\ictMail\DavSync = 1, which
         apps/mailcraft/src/install.rs's dav_sync() reads (an .msi copy only — the portable
         .zip and every other platform's package have no such choice and always have it).
         Unticking it — here, or later through Programs and Features > Change — removes the
         value and the app goes back to IMAP-only; ticking it again writes it back. Nothing
         the user keeps (the mailbox, its calendars and contacts) is touched either way:
         they are the user's own files, not installed components. -->
    <Feature Id="DavSync" Title="ictMail ActiveSync" Level="1"
        Description="Syncs calendar and contacts with your mail account. Not needed for an IMAP-only setup.">
      <Component Id="MailcraftDavSync" Guid="CF98B3AC-37B8-41C4-829A-16327909B05C" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="Software\ictMail" Name="DavSync" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MailcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="MailcraftApp" Guid="6883EF8E-7160-4B89-85C5-0DB6E7264E61">
        <File Id="MailcraftExe" Source="$(var.BinDir)\ictmail.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="ictMail"
              Description="ictMail mail and calendar" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="IctMailIcon.ico" IconIndex="0">
            <!-- The AppUserModelID Windows knows ictMail by: it shows the program's desktop
                 alerts (toasts) only for a program it knows by such a shortcut
                 (apps/mailcraft/src/alerts.rs). -->
            <ShortcutProperty Key="System.AppUserModel.ID" Value="ictMail.ictMail" />
          </Shortcut>
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\ictmail.exe" Value="[#MailcraftExe]" Type="string" />
      </Component>

      <!-- What ictMail opens. Each file type gets a ictMail ProgId (name, icon, open command)
           and is listed under the extension's OpenWithProgids, so ictMail shows in Explorer's "Open
           with"; messages, calendar files and contact cards are also ictMail's Capabilities
           (RegisteredApplications), as is the mailto: link type, so ictMail appears in Settings ›
           Default apps, where the owner makes it the mail program. Nothing here sets a default for a
           type another program may own: the installer never takes over .eml, .ics, .vcf or mailto:.
           A mailbox file (.mailcraft) is ictMail's own and opens with it. A second start hands the
           file or link to the window that is already open (apps/mailcraft/src/single_instance.rs).
           Removed again on uninstall. -->
      <Component Id="MailcraftFileTypes" Guid="D5E14B14-1BE0-4E96-A849-E5F04AC4D6BB">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="ictMail" Value="Software\ictMail\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities" Name="ApplicationName" Value="ictMail" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities" Name="ApplicationDescription" Value="Mail, calendar, contacts and tasks; opens messages, calendar files and contact cards." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities" Name="ApplicationIcon" Value="&quot;[#MailcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\ictmail.exe" Name="FriendlyAppName" Value="ictMail" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\ictmail.exe\shell\open\command" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="ictMail.Message" Description="Email Message" Icon="MailcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ictMail.Message\shell\open\command" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.eml\OpenWithProgids" Name="ictMail.Message" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\ictmail.exe\SupportedTypes" Name=".eml" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities\FileAssociations" Name=".eml" Value="ictMail.Message" Type="string" />

        <ProgId Id="ictMail.Calendar" Description="iCalendar File" Icon="MailcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ictMail.Calendar\shell\open\command" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ics\OpenWithProgids" Name="ictMail.Calendar" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\ictmail.exe\SupportedTypes" Name=".ics" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities\FileAssociations" Name=".ics" Value="ictMail.Calendar" Type="string" />

        <ProgId Id="ictMail.Contact" Description="vCard File" Icon="MailcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ictMail.Contact\shell\open\command" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.vcf\OpenWithProgids" Name="ictMail.Contact" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\ictmail.exe\SupportedTypes" Name=".vcf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities\FileAssociations" Name=".vcf" Value="ictMail.Contact" Type="string" />

        <ProgId Id="ictMail.MailFolder" Description="Mail Folder File" Icon="MailcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ictMail.MailFolder\shell\open\command" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mbox\OpenWithProgids" Name="ictMail.MailFolder" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\ictmail.exe\SupportedTypes" Name=".mbox" Value="" Type="string" />

        <ProgId Id="ictMail.Mailbox" Description="ictMail Mailbox" Icon="MailcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ictMail.Mailbox\shell\open\command" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mailcraft\OpenWithProgids" Name="ictMail.Mailbox" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\ictmail.exe\SupportedTypes" Name=".mailcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities\FileAssociations" Name=".mailcraft" Value="ictMail.Mailbox" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mailcraft" Value="ictMail.Mailbox" Type="string" />

        <!-- mailto: links. `URL Protocol` marks the ProgId as a link handler. -->
        <ProgId Id="ictMail.Url.mailto" Description="ictMail Mail Link" Icon="MailcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ictMail.Url.mailto" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ictMail.Url.mailto\shell\open\command" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ictMail\Capabilities\URLAssociations" Name="mailto" Value="ictMail.Url.mailto" Type="string" />
      </Component>
      <Component Id="MailcraftUpdatePolicy" Guid="3B0C9E57-5A2D-4F0B-9C0E-7D8E2F61A4C3" Condition="DISABLEAUTOMATICUPDATES = 1">
        <RegistryValue Root="HKLM" Key="Software\Policies\ictMail" Name="DisableAutomaticUpdates" Value="1" Type="integer" KeyPath="yes" />
      </Component>
      <Component Id="MailcraftCli">
        <File Id="MailcraftCliExe" Source="$(var.BinDir)\ictmail-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
